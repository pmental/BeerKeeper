# Copy this file to .env and fill in a real secret before running docker compose.
#
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# or
#   openssl rand -hex 32
#
# This key signs login sessions. Keep it stable across restarts (don't
# regenerate it) or everyone will be logged out; keep it private, or anyone
# who has it can forge a login token for your instance.
CELLAR_SECRET_KEY=

# Which host port to expose the app on. Defaults to 8000 if unset.
CELLAR_PORT=8000

# --- Password authentication -------------------------------------------
# Set to false to disable username/password login and registration entirely
# (the forms are hidden in the UI too). Only do this once CELLAR_OIDC_ENABLED
# below is working, or nobody will be able to log in at all.
CELLAR_PASSWORD_AUTH_ENABLED=true

# --- OIDC / SSO ----------------------------------------------------------
# Set to true to let people log in via an OpenID Connect provider (Authentik,
# Keycloak, Authelia, Google Workspace, Okta, etc.). All four OIDC_* values
# below plus CELLAR_BASE_URL are required if this is true.
CELLAR_OIDC_ENABLED=false

# Your provider's issuer URL - the app fetches
# <issuer>/.well-known/openid-configuration to discover the rest.
# e.g. https://auth.example.com/application/o/cellar/
CELLAR_OIDC_ISSUER=

# Client ID / secret from your provider's application registration.
CELLAR_OIDC_CLIENT_ID=
CELLAR_OIDC_CLIENT_SECRET=

# Space-separated scopes to request. "openid" is required; email/profile
# give us an email address and preferred username to provision accounts with.
CELLAR_OIDC_SCOPES=openid email profile

# Label shown on the login page's SSO button.
CELLAR_OIDC_BUTTON_LABEL=Continue with SSO

# The externally-reachable base URL of THIS app (no trailing slash) - used
# to build the OIDC redirect URI (<CELLAR_BASE_URL>/api/auth/oidc/callback).
# Register that exact URL as an allowed redirect URI with your provider.
# e.g. https://cellar.yourdomain.com  or  http://localhost:8000 for local use
CELLAR_BASE_URL=

# --- Admin recovery -------------------------------------------------------
# The first person to ever register/log in becomes admin automatically -
# you shouldn't need this. It's a recovery lever for the unlikely case a
# deployment ends up with zero admins: comma/whitespace-separated
# usernames to force-grant admin on every boot.
CELLAR_ADMIN_USERNAMES=

# --- SMTP (password reset + welcome emails) -------------------------------
# Set CELLAR_SMTP_HOST and CELLAR_SMTP_FROM_EMAIL to enable outgoing email.
# Both are required; everything else has a sensible default. Requires
# CELLAR_BASE_URL above to be set too, since reset links need an absolute URL.
CELLAR_SMTP_HOST=
CELLAR_SMTP_PORT=587

# "starttls" (default, typically port 587): connect plain, then upgrade.
# "ssl": implicit TLS from the first byte (typically port 465).
# "none": no encryption at all - only for a trusted local relay.
CELLAR_SMTP_SECURITY=starttls

# Leave blank if your relay doesn't require authentication.
CELLAR_SMTP_USERNAME=
CELLAR_SMTP_PASSWORD=

# The "From:" address and display name on outgoing mail.
CELLAR_SMTP_FROM_EMAIL=
CELLAR_SMTP_FROM_NAME=BeerKeeper

# Only for an internal relay using a self-signed certificate. Leave this
# false (the secure default) unless you know why you need it.
CELLAR_SMTP_SKIP_CERT_VERIFY=false
